# SocialCounts API - Contagem em tempo real de inscritos do YouTube
# Não requer chave de API - é uma API pública livre!
# https://socialcounts.org/

# Porta do servidor (produção: use a porta do host, ex. 3001 ou $PORT)
PORT=3001

# Intervalo de atualização em ms (padrão: 3000)
POLL_INTERVAL_MS=3000

# Origem do frontend em dev (opcional)
# CLIENT_ORIGIN=http://localhost:5173
