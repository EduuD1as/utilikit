# Chave da YouTube Data API v3 (obrigatória para dados reais)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=sua_chave_aqui

# Porta do servidor (produção: use a porta do host, ex. 3001 ou $PORT)
PORT=3001

# Intervalo de atualização em ms (padrão: 3000)
POLL_INTERVAL_MS=3000

# Origem do frontend em dev (opcional)
# CLIENT_ORIGIN=http://localhost:5173
