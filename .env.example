# YouTube counter
# SocialCounts and public YouTube pages work without a key.
# Optional: set YouTube Data API v3 key for robust channel lookup and
# official rounded subscriber stats when SocialCounts is unstable.
# YOUTUBE_API_KEY=your_key_here
# Live subscriber provider. Use exactly one provider to avoid mixed counts.
# Options: socialcounts, superplaycounts
YOUTUBE_LIVE_PROVIDER=socialcounts

# Server port
PORT=3001

# Poll interval in ms
POLL_INTERVAL_MS=1000

# Frontend origin in dev (optional)
# CLIENT_ORIGIN=http://localhost:5173
